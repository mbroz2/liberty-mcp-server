<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dem.mcp</groupId>
    <artifactId>liberty-mcp-server</artifactId>
    <name>Liberty - Demo - Model Context Protocol Server</name>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <wlp-dir-path>${basedir}/wlp</wlp-dir-path>
        <wlp-version>26.0.0.4-beta</wlp-version>
        <mcp-jar-version>1.0.111</mcp-jar-version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId> 
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>
        
        <!-- MicroProfile -->
        <dependency>
            <groupId>org.eclipse.microprofile</groupId>
            <artifactId>microprofile</artifactId>
            <version>7.0</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>

        <!-- Liberty MCP API -->
        <dependency>
            <groupId>io.openliberty.mcp</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${mcp-jar-version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/api/io.openliberty.mcp_${mcp-jar-version}.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>mcp-liberty-server</finalName>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.3.2</version>
                    <configuration>
                        <failOnMissingWebXml>false</failOnMissingWebXml>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.openliberty.tools</groupId>
                    <artifactId>liberty-maven-plugin</artifactId>
                    <version>3.11.5</version>
                    <configuration>
                        <runtimeArtifact>
                            <groupId>io.openliberty.beta</groupId>
                            <artifactId>openliberty-runtime</artifactId>
                            <version>${wlp-version}</version>
                            <type>zip</type>
                        </runtimeArtifact>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>io.openliberty.tools</groupId>
                <artifactId>liberty-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
